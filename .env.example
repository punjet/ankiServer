# Anki Server Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Required ────────────────────────────────
# Your DeepL API key (free or paid).
# Free keys end with ":fx"  →  DEEPL_KEY=your-key:fx
DEEPL_KEY=

# ─── Optional (defaults shown) ───────────────
# Port the server listens on.
PORT=5005

# AnkiConnect URL.
# • macOS Docker Desktop: host.docker.internal resolves to your Mac automatically.
# • Linux Docker:         extra_hosts in docker-compose.yml handles this.
ANKI_URL=http://host.docker.internal:8765

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
