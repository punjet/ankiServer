# Anki Server Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# ─── 🔒 Security ──────────────────────────────────────────────────────────────
# Server's own API key — clients must send this in X-API-Key header.
# Generate a strong key:  openssl rand -hex 32
# If left empty, authentication is DISABLED (OK for local use only).
API_KEY=

# ─── 🌐 DeepL (для /translate) ────────────────────────────────────────────────
# Get your key at: https://www.deepl.com/pro-api
# Free keys end with ":fx"  →  DEEPL_KEY=abc123:fx
DEEPL_KEY=

# ─── 🤖 OpenAI (для /grammar) ─────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model to use. gpt-4o-mini is cheap and accurate for grammar tasks.
# Options: gpt-4o-mini | gpt-4o | gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini
# Max Anki cards generated per single /grammar request (1–10)
MAX_CARDS_PER_REQUEST=5

# ─── 🃏 Anki ──────────────────────────────────────────────────────────────────
# macOS Docker Desktop: host.docker.internal resolves to your Mac automatically.
# Linux Docker: extra_hosts in docker-compose.yml handles this.
ANKI_URL=http://host.docker.internal:8765
# Deck and Note Type for grammar error cards (created automatically on first sync)
GRAMMAR_DECK_NAME=GrammarErrors
GRAMMAR_MODEL_NAME=GrammarErrors

# ─── ⚙️ Server ────────────────────────────────────────────────────────────────
PORT=5005
LOG_LEVEL=info

# ─── 💾 Storage ───────────────────────────────────────────────────────────────
# File to store pending cards. When running in Docker/Coolify, use a persistent path!
BUFFER_FILE=/app/data/anki_buffer.json
# File to write server logs to (in addition to standard output).
LOG_FILE=/app/data/server.log

# ─── 🛡️ Rate Limiting & Limits ────────────────────────────────────────────────
# Max requests per minute per IP for standard endpoints
RATE_LIMIT_DEFAULT=60
# Max requests per minute per IP for /grammar (AI calls are expensive)
RATE_LIMIT_GRAMMAR=10
# Max request body size in bytes (default: 64 KB)
MAX_BODY_BYTES=65536
# Max text length in /grammar in Unicode characters
MAX_TEXT_LENGTH=4000
# Trust X-Forwarded-For header (set true when behind Coolify/nginx)
TRUSTED_PROXIES=true
