# Anki Server Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── DeepL (для перевода слов) ───────────────
# Free keys end with ":fx"  →  DEEPL_KEY=your-key:fx
DEEPL_KEY=

# ─── OpenAI (для анализа грамматики) ─────────
OPENAI_API_KEY=
# Модель по умолчанию — дешёвая и быстрая.
# Варианты: gpt-4o-mini | gpt-4o | gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini
# Максимум карточек за один запрос /grammar
MAX_CARDS_PER_REQUEST=5

# ─── Anki (опционально) ──────────────────────
# На macOS Docker Desktop host.docker.internal резолвится автоматически.
ANKI_URL=http://host.docker.internal:8765
# Название колоды и модели для грамматических карточек
GRAMMAR_DECK_NAME=GrammarErrors
GRAMMAR_MODEL_NAME=GrammarErrors

# ─── Сервер ──────────────────────────────────
PORT=5005
LOG_LEVEL=info
